<Application x:Class="WpfWidgets.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default theme, loaded at startup -->
                <ResourceDictionary Source="/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MaterialSymbolsOutlined">pack://application:,,,/WpfWidgets;component/Fonts/MaterialSymbolsOutlined.ttf#Material Symbols Outlined</FontFamily>

            <!-- ========================================== -->
            <!-- SHARED CARD STYLE FOR ALL WIDGETS -->
            <!-- ========================================== -->
            <Style x:Key="OuterGlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="WidgetCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WidgetBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorder}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
            <!-- GLOBAL CONTROL STYLES FOR ALL SETTINGS VIEWS -->
            <!-- ========================================== -->

            <!-- 1. Modern Sliding Toggle Switch Style for CheckBox -->
            <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource DashboardText}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <BulletDecorator Background="Transparent" Cursor="Hand">
                                <BulletDecorator.Bullet>
                                    <Grid Width="44" Height="22">
                                        <!-- Background Track (Unchecked) -->
                                        <Border x:Name="TrackUnchecked" 
                                                Background="{DynamicResource SidebarActiveBackground}" 
                                                BorderBrush="{DynamicResource DashboardBorder}"
                                                BorderThickness="1" 
                                                CornerRadius="11" 
                                                SnapsToDevicePixels="True"/>
                                        
                                        <!-- Background Track (Checked) -->
                                        <Border x:Name="TrackChecked" 
                                                Background="#FF0078D4" 
                                                BorderBrush="{DynamicResource DashboardBorder}"
                                                BorderThickness="1" 
                                                CornerRadius="11" 
                                                Opacity="0"
                                                SnapsToDevicePixels="True"/>
                                        
                                        <!-- Sliding Thumb Indicator -->
                                        <Border x:Name="Thumb" 
                                                Background="White" 
                                                Width="16" 
                                                Height="16" 
                                                CornerRadius="8" 
                                                HorizontalAlignment="Left" 
                                                Margin="3,0,3,0"
                                                VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="5" ShadowDepth="1.5"/>
                                            </Border.Effect>
                                        </Border>
                                    </Grid>
                                </BulletDecorator.Bullet>
                                <ContentPresenter Margin="8,0,0,0" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </BulletDecorator>
                            
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Fade track to active blue -->
                                                <DoubleAnimation Storyboard.TargetName="TrackChecked" 
                                                                 Storyboard.TargetProperty="Opacity" 
                                                                 To="1.0" 
                                                                 Duration="0:0:0.15"/>
                                                <!-- Slide thumb to the right -->
                                                <ThicknessAnimation Storyboard.TargetName="Thumb" 
                                                                    Storyboard.TargetProperty="Margin" 
                                                                    To="23,0,3,0" 
                                                                    Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Fade track back to unchecked state -->
                                                <DoubleAnimation Storyboard.TargetName="TrackChecked" 
                                                                 Storyboard.TargetProperty="Opacity" 
                                                                 To="0.0" 
                                                                 Duration="0:0:0.15"/>
                                                <!-- Slide thumb back to the left -->
                                                <ThicknessAnimation Storyboard.TargetName="Thumb" 
                                                                    Storyboard.TargetProperty="Margin" 
                                                                    To="3,0,3,0" 
                                                                    Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TrackUnchecked" Property="BorderBrush" Value="{DynamicResource DashboardText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 2. Minimalist ComboBox Toggle Template -->
            <ControlTemplate x:Key="ComboBoxTextBoxTemplate" TargetType="ToggleButton">
                <Border x:Name="Border" 
                        Background="{DynamicResource SidebarHoverBackground}" 
                        BorderBrush="{DynamicResource DashboardBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Chevron Dropdown Arrow (Segoe MDL2 Glyph) -->
                        <TextBlock Grid.Column="1" 
                                   Text="" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="{DynamicResource DashboardSubText}" 
                                   FontSize="10" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource DashboardBorder}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 3. Modern Flat ComboBox Styling -->
            <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource DashboardText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,0,0,0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- Clickable Toggle Button -->
                                <ToggleButton Name="ToggleButton" 
                                              Template="{StaticResource ComboBoxTextBoxTemplate}" 
                                              Focusable="false" 
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                
                                <!-- Display Area -->
                                <ContentPresenter Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  Margin="12,3,30,3" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left"/>
                                
                                <!-- Dropdown Popup -->
                                <Popup Name="Popup" 
                                       Placement="Bottom" 
                                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       AllowsTransparency="True" 
                                       Focusable="False" 
                                       PopupAnimation="Slide">
                                    <Grid Name="DropDown" 
                                          SnapsToDevicePixels="True" 
                                          MinWidth="{TemplateBinding ActualWidth}" 
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                          Margin="0,4,0,4">
                                        <!-- Dropdown Border/Container -->
                                         <Border x:Name="DropDownBorder" 
                                                 Background="{DynamicResource DashboardBackground}" 
                                                 BorderBrush="{DynamicResource DashboardBorder}" 
                                                 BorderThickness="1" 
                                                 CornerRadius="8">
                                             <Border.Effect>
                                                 <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="2"/>
                                             </Border.Effect>
                                            <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 4. ComboBoxItem Styling -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource DashboardText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,6,10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}" 
                                    Margin="2,1,2,1"
                                    SnapsToDevicePixels="true">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="true">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="Border" Property="Background" Value="#FF0078D4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Modern ScrollBar Style -->
            <Style TargetType="ScrollBar">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="true"
                                       IsEnabled="{TemplateBinding IsEnabled}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="false"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="false"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{DynamicResource DashboardSubText}"
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Center"
                                                            Width="6"
                                                            Opacity="0.45"
                                                            SnapsToDevicePixels="True"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                                            <Setter TargetName="ThumbBorder" Property="Width" Value="8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="true">
                                                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                            <Setter TargetName="ThumbBorder" Property="Width" Value="8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
