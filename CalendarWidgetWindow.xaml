<Window x:Class="WpfWidgets.CalendarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar Events Widget" 
        Height="380" 
        Width="320"
        MinHeight="200"
        MinWidth="250"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged"
        Icon="/app-icon-light.ico">
    
    <Grid Background="#01FFFFFF">
        <!-- Layer 1: Outer Glass Container (aligned to window edge) -->
        <Border x:Name="OuterGlassCard"
                Style="{StaticResource OuterGlassCardStyle}"
                MouseLeftButtonDown="WidgetCard_MouseLeftButtonDown"
                MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp"
                MouseMove="WidgetCard_MouseMove">
            
            <!-- Layer 2: Inner Content Card -->
            <Border x:Name="WidgetCard"
                    Style="{StaticResource WidgetCardStyle}">
                
                <Grid Margin="16,16,16,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="*"/>    <!-- Events List -->
                </Grid.RowDefinitions>
                
                <!-- 1. Header Area -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                               
                    <!-- Date Title -->
                    <TextBlock x:Name="DateText"
                               Grid.Column="0"
                               Text="Calendar Events"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource WidgetFont}"
                               Foreground="{DynamicResource WidgetText}"
                               VerticalAlignment="Center"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Content=""
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="{DynamicResource WidgetText}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Opacity="0.7"
                            RenderTransformOrigin="0.5,0.5"
                            Click="RefreshButton_Click">
                        <Button.RenderTransform>
                            <RotateTransform x:Name="RefreshButtonRotation" Angle="0"/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <!-- 2. Separator Line -->
                <Separator Grid.Row="1" Background="{DynamicResource WidgetBorder}" Margin="0,0,0,12"/>
                
                <!-- 3. Content Panel -->
                <Grid Grid.Row="2">
                    <!-- Empty State Text (visible when no events at all) -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="No events scheduled."
                               FontSize="13"
                               FontStyle="Italic"
                               FontFamily="{DynamicResource WidgetFont}"
                               Foreground="{DynamicResource WidgetSubText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.8"
                               Visibility="Collapsed"/>
                    
                    <!-- Events ScrollViewer -->
                    <ScrollViewer x:Name="EventsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <StackPanel>
                            <!-- TODAY SECTION -->
                            <StackPanel x:Name="TodaySection" Margin="0,0,0,14">
                                <TextBlock Text="TODAY" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource WidgetText}" 
                                           Opacity="0.75" 
                                           Margin="4,0,0,8"/>
                                <ItemsControl x:Name="TodayEventsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" Height="32" CornerRadius="1.5" Background="{Binding AccentBrush}" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WidgetText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="{DynamicResource WidgetSubText}"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource WidgetSubText}" Visibility="{Binding TimeSeparatorVisibility}"/>
                                                        <TextBlock Text="{Binding DurationDisplay}" FontSize="10" Foreground="{DynamicResource WidgetSubText}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TodayEmptyLabel" 
                                           Text="No events today" 
                                           FontSize="12" 
                                           FontStyle="Italic" 
                                           Foreground="{DynamicResource WidgetSubText}" 
                                           Margin="16,4,0,4" 
                                           Opacity="0.5"/>
                            </StackPanel>

                            <!-- TOMORROW SECTION -->
                            <StackPanel x:Name="TomorrowSection">
                                <TextBlock Text="TOMORROW" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource WidgetText}" 
                                           Opacity="0.75" 
                                           Margin="4,0,0,8"/>
                                <ItemsControl x:Name="TomorrowEventsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" Height="32" CornerRadius="1.5" Background="{Binding AccentBrush}" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WidgetText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="{DynamicResource WidgetSubText}"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource WidgetSubText}" Visibility="{Binding TimeSeparatorVisibility}"/>
                                                        <TextBlock Text="{Binding DurationDisplay}" FontSize="10" Foreground="{DynamicResource WidgetSubText}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TomorrowEmptyLabel" 
                                           Text="No events tomorrow" 
                                           FontSize="12" 
                                           FontStyle="Italic" 
                                           Foreground="{DynamicResource WidgetSubText}" 
                                           Margin="16,4,0,4" 
                                           Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
