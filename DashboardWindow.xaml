<Window x:Class="WpfWidgets.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widgets Dashboard" 
        Height="560" 
        Width="890"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Icon="/app-icon-light.ico">
    
    <Window.Resources>
        <!-- Modern Sidebar Tab Button Style using RadioButton -->
        <Style x:Key="SidebarTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SidebarUncheckedForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon (using Content of TemplateBinding) -->
                                <TextBlock x:Name="Icon" 
                                           Grid.Column="0" 
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                           FontFamily="{StaticResource MaterialSymbolsOutlined}" 
                                           FontSize="18" 
                                           Typography.StandardLigatures="True"
                                           Typography.ContextualLigatures="True"
                                           Foreground="{TemplateBinding Foreground}" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"/>
                                
                                <!-- Text Content -->
                                <ContentPresenter Grid.Column="1" 
                                                  Content="{TemplateBinding Content}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DashboardText}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DashboardText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                <Setter Property="Foreground" Value="#FF0078D4"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#FF0078D4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
 
    <Grid>
        <!-- Outer Glowing Card container -->
        <Border Background="{DynamicResource DashboardBackground}" 
                BorderBrush="{DynamicResource DashboardBorder}" 
                BorderThickness="1.5" 
                CornerRadius="24"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="20" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Sidebar & Content Panel -->
                </Grid.RowDefinitions>
                
                <!-- 1. Header Row -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xF500;" 
                                   FontFamily="{StaticResource MaterialSymbolsOutlined}" 
                                   Typography.StandardLigatures="True"
                                   Typography.ContextualLigatures="True"
                                   Foreground="#FF0078D4" 
                                   FontSize="20" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Chronos Widgets" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource DashboardText}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Click="CloseButton_Click"
                            HorizontalAlignment="Right" 
                            Width="32" 
                            Height="32" 
                            Background="Transparent" 
                            BorderBrush="Transparent"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="16" x:Name="border">
                                     <TextBlock Text="&#xE5CD;" FontFamily="{StaticResource MaterialSymbolsOutlined}" Typography.StandardLigatures="True" Typography.ContextualLigatures="True" Foreground="{DynamicResource DashboardSubText}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="text"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#33FF0055"/>
                                        <Setter TargetName="text" Property="Foreground" Value="#FFFF3366"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- 2. Sidebar & Content split layout -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/> <!-- Sidebar Navigation -->
                        <ColumnDefinition Width="24"/>  <!-- Gap -->
                        <ColumnDefinition Width="*"/>   <!-- Dynamic Settings Content View -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Sidebar Menu (In Container) -->
                    <Border Grid.Column="0" 
                            Background="{DynamicResource SidebarHoverBackground}" 
                            BorderBrush="{DynamicResource DashboardBorder}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="8,12">
                        <StackPanel>
                            <RadioButton Content="General" 
                                         Style="{StaticResource SidebarTabStyle}" 
                                         Tag="&#xE8B8;" 
                                         IsChecked="True" 
                                         Checked="NavButton_Checked"/>
                            
                            <RadioButton Content="Clock Widget" 
                                         Style="{StaticResource SidebarTabStyle}" 
                                         Tag="&#xF8BB;" 
                                         Checked="NavButton_Checked"/>
                            
                            <RadioButton Content="Calendar Widget" 
                                         Style="{StaticResource SidebarTabStyle}" 
                                         Tag="&#xE878;" 
                                         Checked="NavButton_Checked"/>
                            
                            <RadioButton Content="Tasks Widget" 
                                         Style="{StaticResource SidebarTabStyle}" 
                                         Tag="&#xE8E9;" 
                                         Checked="NavButton_Checked"/>
                            
                            <RadioButton Content="Weather Widget" 
                                         Style="{StaticResource SidebarTabStyle}" 
                                         Tag="&#xF172;" 
                                         Checked="NavButton_Checked"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Right Content Area (Free standing Grid) -->
                    <Grid Grid.Column="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Startup Warning Banner Prompt -->
                            <Border x:Name="StartupBanner" 
                                    Grid.Row="0" 
                                    Background="#1A0078D4" 
                                    BorderBrush="#300078D4" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="12,10" 
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Info Icon (Segoe MDL2 Assets) -->
                                    <TextBlock Grid.Column="0" 
                                               Text="" 
                                               FontFamily="Segoe MDL2 Assets" 
                                               Foreground="#FF0078D4" 
                                               FontSize="16" 
                                               VerticalAlignment="Center"/>
                                    
                                    <!-- Banner Text Panel -->
                                    <StackPanel Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="Enable Start with Windows" 
                                                   Foreground="{DynamicResource DashboardText}" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Allow widgets to run automatically at login so they stay active." 
                                                   Foreground="{DynamicResource DashboardSubText}" 
                                                   FontSize="10" 
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Actions Panel -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Action Button: Enable Now -->
                                        <Button Click="EnableStartup_Click"
                                                Content="Enable Now" 
                                                FontSize="11" 
                                                Padding="10,4"
                                                Background="#FF0078D4" 
                                                Foreground="White" 
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        
                                        <!-- Dismiss Button: Close -->
                                        <Button Click="DismissBanner_Click"
                                                Margin="8,0,0,0" 
                                                Width="24" 
                                                Height="24"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="12" x:Name="border">
                                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DashboardSubText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Dynamic Content Control -->
                            <ContentControl x:Name="ActiveSettingsPanel" 
                                            Grid.Row="1"
                                            VerticalAlignment="Stretch" 
                                            HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
