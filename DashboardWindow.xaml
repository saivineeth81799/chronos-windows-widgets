<Window x:Class="WpfWidgets.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widgets Dashboard" 
        Height="560" 
        Width="890"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Icon="/app-icon-light.ico">
    
    <Window.Resources>
        <!-- Modern Sidebar Tab Button Style using RadioButton -->
        <Style x:Key="SidebarTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SidebarUncheckedForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon (using Content of TemplateBinding) -->
                                <TextBlock x:Name="Icon" 
                                           Grid.Column="0" 
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                           FontFamily="{StaticResource MaterialSymbolsOutlined}" 
                                           FontSize="18" 
                                           Typography.StandardLigatures="True"
                                           Typography.ContextualLigatures="True"
                                           Foreground="{TemplateBinding Foreground}" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"/>
                                
                                <!-- Text Content -->
                                <ContentPresenter Grid.Column="1" 
                                                  Content="{TemplateBinding Content}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DashboardText}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DashboardText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                <Setter Property="Foreground" Value="#FF0078D4"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#FF0078D4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
 
    <Grid>
        <!-- Outer Glowing Card container -->
        <Border Background="{DynamicResource DashboardBackground}" 
                BorderBrush="{DynamicResource DashboardBorder}" 
                BorderThickness="1.5" 
                CornerRadius="24"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="20" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Sidebar & Content Panel -->
                </Grid.RowDefinitions>
                
                <!-- 1. Header Row -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xF500;" 
                                   FontFamily="{StaticResource MaterialSymbolsOutlined}" 
                                   Typography.StandardLigatures="True"
                                   Typography.ContextualLigatures="True"
                                   Foreground="#FF0078D4" 
                                   FontSize="20" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Chronos Widgets" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource DashboardText}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Click="CloseButton_Click"
                            HorizontalAlignment="Right" 
                            Width="32" 
                            Height="32" 
                            Background="Transparent" 
                            BorderBrush="Transparent"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="16" x:Name="border">
                                     <TextBlock Text="&#xE5CD;" FontFamily="{StaticResource MaterialSymbolsOutlined}" Typography.StandardLigatures="True" Typography.ContextualLigatures="True" Foreground="{DynamicResource DashboardSubText}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="text"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#33FF0055"/>
                                        <Setter TargetName="text" Property="Foreground" Value="#FFFF3366"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- 2. Sidebar & Content split layout -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/> <!-- Sidebar Navigation -->
                        <ColumnDefinition Width="24"/>  <!-- Gap -->
                        <ColumnDefinition Width="*"/>   <!-- Dynamic Settings Content View -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Sidebar Menu (In Container) -->
                    <Border Grid.Column="0" 
                            Background="{DynamicResource SidebarHoverBackground}" 
                            BorderBrush="{DynamicResource DashboardBorder}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="8,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0">
                                <RadioButton Content="General" 
                                             Style="{StaticResource SidebarTabStyle}" 
                                             Tag="&#xE8B8;" 
                                             IsChecked="True" 
                                             Checked="NavButton_Checked"/>
                                
                                <RadioButton Content="Clock Widget" 
                                             Style="{StaticResource SidebarTabStyle}" 
                                             Tag="&#xF8BB;" 
                                             Checked="NavButton_Checked"/>
                                
                                <RadioButton Content="Calendar Widget" 
                                             Style="{StaticResource SidebarTabStyle}" 
                                             Tag="&#xE878;" 
                                             Checked="NavButton_Checked"/>
                                
                                <RadioButton Content="Tasks Widget" 
                                             Style="{StaticResource SidebarTabStyle}" 
                                             Tag="&#xE8E9;" 
                                             Checked="NavButton_Checked"/>
                                
                                <RadioButton Content="Weather Widget" 
                                             Style="{StaticResource SidebarTabStyle}" 
                                             Tag="&#xF172;" 
                                             Checked="NavButton_Checked"/>
                            </StackPanel>

                            <!-- Startup Warning Card at bottom of menu container -->
                            <StackPanel x:Name="StartupBanner"
                                        Grid.Row="1"
                                        Visibility="Collapsed">
                                <!-- Separator line divider -->
                                <Separator Background="{DynamicResource DashboardBorder}" Height="1" Margin="4,8,4,12"/>
                                
                                <Grid Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#FFF7630C" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Startup Disabled" Foreground="{DynamicResource DashboardText}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <TextBlock Text="Widgets won't launch automatically on PC startup." Foreground="{DynamicResource DashboardSubText}" FontSize="9.5" TextWrapping="Wrap" Margin="4,0,4,10"/>
                                
                                <Button Click="EnableStartup_Click" Content="Enable Auto-Start" FontSize="10.5" Height="26" Margin="4,0,4,0" Cursor="Hand" HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#FF0078D4" CornerRadius="6">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#FF2B88D9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#FF005A9E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Mobile App Link Card at bottom of menu container when startup is enabled -->
                            <StackPanel x:Name="MobileAppBanner"
                                        Grid.Row="1"
                                        Visibility="Collapsed">
                                <!-- Separator line divider -->
                                <Separator Background="{DynamicResource DashboardBorder}" Height="1" Margin="4,8,4,12"/>
                                
                                <Grid Margin="4,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{DynamicResource AppIconImage}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Chronos Mobile" Foreground="{DynamicResource DashboardText}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <TextBlock Text="Sync your tasks and track time on your mobile phone." Foreground="{DynamicResource DashboardSubText}" FontSize="9.5" TextWrapping="Wrap" Margin="4,0,4,12"/>
                                
                                <!-- Play Store Button -->
                                <Button Click="DownloadMobileApp_Click" Height="30" Margin="4,0,4,8" Cursor="Hand" HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{DynamicResource StoreButtonBackground}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/play-store.png" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Get on Android" Foreground="{DynamicResource StoreButtonForeground}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource StoreButtonHoverBackground}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource StoreButtonPressedBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                
                                <!-- App Store (iOS) Coming Soon Button -->
                                <Button IsEnabled="False" Height="30" Margin="4,0,4,4" HorizontalAlignment="Stretch" Opacity="0.35">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{DynamicResource StoreButtonBackground}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/app-store.png" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="iOS (Coming Soon)" Foreground="{DynamicResource StoreButtonForeground}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Right Content Area (Free standing Grid) -->
                    <Grid Grid.Column="2">
                        <!-- Dynamic Content Control -->
                        <ContentControl x:Name="ActiveSettingsPanel" 
                                        VerticalAlignment="Stretch" 
                                        HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
