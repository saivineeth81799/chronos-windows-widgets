<Window x:Class="WpfWidgets.TasksWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasks Widget" 
        Height="380" 
        Width="320"
        MinHeight="200"
        MinWidth="250"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged"
        Icon="/app-icon-light.ico">
    
    <Grid Background="#01FFFFFF">
        <!-- Layer 1: Outer Glass Container (aligned to window edge) -->
        <Border x:Name="OuterGlassCard"
                Style="{StaticResource OuterGlassCardStyle}"
                MouseLeftButtonDown="WidgetCard_MouseLeftButtonDown"
                MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp"
                MouseMove="WidgetCard_MouseMove">
            
            <!-- Layer 2: Inner Content Card -->
            <Border x:Name="WidgetCard"
                    Style="{StaticResource WidgetCardStyle}">
                
                <Grid Margin="16,16,16,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="*"/>    <!-- Tasks List -->
                </Grid.RowDefinitions>
                
                <!-- 1. Header Area -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                                
                    <!-- Title -->
                    <TextBlock x:Name="HeaderTitleText"
                               Grid.Column="0"
                               Text="Tasks List"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource WidgetFont}"
                               Foreground="{DynamicResource WidgetText}"
                               VerticalAlignment="Center"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Content=""
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="{DynamicResource WidgetText}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Opacity="0.7"
                            RenderTransformOrigin="0.5,0.5"
                            Click="RefreshButton_Click">
                        <Button.RenderTransform>
                            <RotateTransform x:Name="RefreshButtonRotation" Angle="0"/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <!-- 2. Separator Line -->
                <Separator Grid.Row="1" Background="{DynamicResource WidgetBorder}" Margin="0,0,0,12"/>
                
                <!-- 3. Content Panel -->
                <Grid Grid.Row="2">
                    <!-- Empty State Text -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="No active tasks."
                               FontSize="13"
                               FontStyle="Italic"
                               FontFamily="{DynamicResource WidgetFont}"
                               Foreground="{DynamicResource WidgetSubText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.8"
                               Visibility="Collapsed"/>
                    
                    <!-- Tasks ScrollViewer -->
                    <ScrollViewer x:Name="TasksScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <ItemsControl x:Name="TasksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <!-- Header Layout (visible only if Header) -->
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource WidgetText}" 
                                                   Opacity="0.75" 
                                                   Margin="4,8,0,6"
                                                   Visibility="{Binding HeaderVisibility}"/>
                                        
                                        <!-- Task Item Layout (visible only if Task) -->
                                        <Grid Visibility="{Binding TaskVisibility}" Margin="0,3,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Priority Indicator -->
                                                <ColumnDefinition Width="*"/>    <!-- Task Title -->
                                                <ColumnDefinition Width="Auto"/> <!-- Subtask Progress -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Priority Dot -->
                                            <Ellipse Grid.Column="0" 
                                                     Width="8" 
                                                     Height="8" 
                                                     Fill="{Binding PriorityBrush}" 
                                                     Margin="6,0,10,0" 
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding PriorityDotVisibility}"/>
                                            
                                            <!-- Title -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Title}" 
                                                       FontSize="12.5" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource WidgetText}" 
                                                       Opacity="{Binding TaskOpacity}"
                                                       TextDecorations="{Binding TitleDecorations}"
                                                       TextWrapping="Wrap" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       MaxHeight="38" 
                                                       VerticalAlignment="Center"/>
                                            
                                            <!-- Checklist progress -->
                                            <Border Grid.Column="2" 
                                                    Background="#15FFFFFF" 
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    Margin="8,0,4,0" 
                                                    VerticalAlignment="Center" 
                                                    Visibility="{Binding ChecklistProgressVisibility}">
                                                <TextBlock Text="{Binding ChecklistProgress}" 
                                                           FontSize="9.5" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource WidgetSubText}"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
