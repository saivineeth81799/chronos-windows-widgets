<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Color definitions -->
    <SolidColorBrush x:Key="WidgetBackground" Color="#FF18181A"/>
    <SolidColorBrush x:Key="WidgetBorder" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="WidgetText" Color="#E5FFFFFF"/>
    <SolidColorBrush x:Key="WidgetSubText" Color="#77FFFFFF"/>
    <SolidColorBrush x:Key="GlassTintBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#15FFFFFF"/>
    
    <!-- Font family -->
    <FontFamily x:Key="WidgetFont">Segoe UI Semibold</FontFamily>
    
    <!-- Outer Card Border Glow/Shadow (Disabled) -->
    <DropShadowEffect x:Key="WidgetShadow" 
                      Opacity="0" 
                      BlurRadius="0" 
                      ShadowDepth="0"/>
                      
    <!-- Enabled Shadow for comparison on a single widget (slightly stronger for dark mode) -->
    <DropShadowEffect x:Key="TasksWidgetShadow" 
                      Color="Black"
                      Opacity="0.35" 
                      BlurRadius="15" 
                      ShadowDepth="3"
                      Direction="270"/>
                      
    <!-- Dashboard theme resources -->
    <SolidColorBrush x:Key="DashboardBackground" Color="#FF121215"/>
    <SolidColorBrush x:Key="DashboardBorder" Color="#FF202025"/>
    <SolidColorBrush x:Key="DashboardText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DashboardSubText" Color="#FFB3B3B3"/>
    <SolidColorBrush x:Key="SidebarHoverBackground" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveBackground" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SidebarUncheckedForeground" Color="#FFCCCCCC"/>
    
    <!-- Store Button dynamic styling -->
    <SolidColorBrush x:Key="StoreButtonBackground" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="StoreButtonForeground" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="StoreButtonHoverBackground" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="StoreButtonPressedBackground" Color="#FFD1D1D6"/>

    <!-- App Icon dynamic styling -->
    <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/app-icon-dark.ico"/>
</ResourceDictionary>
