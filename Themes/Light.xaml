<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Color definitions for Glass Theme (Light Mode) -->
    <SolidColorBrush x:Key="WidgetBackground" Color="#FFFFFFFF"/> 
    <SolidColorBrush x:Key="WidgetBorder" Color="#20000000"/>      
    <SolidColorBrush x:Key="WidgetText" Color="#FF1A1A1A"/>        
    <SolidColorBrush x:Key="WidgetSubText" Color="#FF4A4A4F"/>     
    <SolidColorBrush x:Key="GlassTintBrush" Color="#0B000000"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#15000000"/>     
    
    <!-- Font family -->
    <FontFamily x:Key="WidgetFont">Segoe UI Semibold</FontFamily>
    
    <!-- Outer Card Border Glow/Shadow (Disabled) -->
    <DropShadowEffect x:Key="WidgetShadow" 
                      Opacity="0" 
                      BlurRadius="0" 
                      ShadowDepth="0"/>
                      
    <!-- Enabled Shadow for comparison on a single widget -->
    <DropShadowEffect x:Key="TasksWidgetShadow" 
                      Color="Black"
                      Opacity="0.15" 
                      BlurRadius="12" 
                      ShadowDepth="2"
                      Direction="270"/>
                      
    <!-- Dashboard theme resources -->
    <SolidColorBrush x:Key="DashboardBackground" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="DashboardBorder" Color="#FFE0E0E5"/>
    <SolidColorBrush x:Key="DashboardText" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="DashboardSubText" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="SidebarHoverBackground" Color="#0A000000"/>
    <SolidColorBrush x:Key="SidebarActiveBackground" Color="#1A000000"/>
    <SolidColorBrush x:Key="SidebarUncheckedForeground" Color="#FF4A4A4F"/>
    
    <!-- Store Button dynamic styling -->
    <SolidColorBrush x:Key="StoreButtonBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="StoreButtonForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="StoreButtonHoverBackground" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="StoreButtonPressedBackground" Color="#FF000000"/>

    <!-- App Icon dynamic styling -->
    <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/app-icon-light.ico"/>
</ResourceDictionary>
