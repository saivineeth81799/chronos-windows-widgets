<UserControl x:Class="WpfWidgets.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="0,0,12,0">
            <!-- Title Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="&#xE8B8;" 
                           FontFamily="{StaticResource MaterialSymbolsOutlined}" 
                           Typography.StandardLigatures="True"
                           Typography.ContextualLigatures="True"
                           Foreground="#FF0078D4" 
                           FontSize="18" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"/>
                <TextBlock Text="General Settings" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource DashboardText}" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Separator Background="{DynamicResource DashboardBorder}" Margin="0,0,0,16"/>

            <!-- Startup Toggle Option Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" 
                               Foreground="{DynamicResource DashboardText}" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Launch widgets automatically when your computer starts" 
                               Foreground="{DynamicResource DashboardSubText}" 
                               FontSize="11" 
                               Margin="0,2,0,0"/>
                </StackPanel>
                
                <CheckBox x:Name="StartupToggle" 
                          Grid.Column="1" 
                          Style="{StaticResource ToggleSwitchStyle}"
                          Checked="StartupToggle_Changed" 
                          Unchecked="StartupToggle_Changed"
                          VerticalAlignment="Center"/>
            </Grid>

            <Separator Background="{DynamicResource DashboardBorder}" Margin="0,16"/>

            <!-- Theme Selector Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Widget Theme" Foreground="{DynamicResource DashboardText}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose global theme layout and colors" Foreground="{DynamicResource DashboardSubText}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                
                <ComboBox x:Name="ThemeSelector" 
                          Grid.Column="1" 
                          Width="160" 
                          Height="32"
                          Style="{StaticResource ModernComboBoxStyle}"
                          SelectionChanged="ThemeSelector_SelectionChanged">
                    <!-- Items set dynamically in code behind -->
                </ComboBox>
            </Grid>

            <Separator Background="{DynamicResource DashboardBorder}" Margin="0,16"/>

            <!-- Widget Opacity Slider Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Widget Opacity" Foreground="{DynamicResource DashboardText}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OpacityValueText" Text="90%" Foreground="{DynamicResource DashboardSubText}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                
                <Slider x:Name="OpacitySlider" 
                        Grid.Column="1" 
                        Width="160" 
                        Minimum="10" 
                        Maximum="100" 
                        Value="90" 
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </Grid>

            <Separator Background="{DynamicResource DashboardBorder}" Margin="0,16"/>

            <!-- Google Account Section -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Google Account" Foreground="{DynamicResource DashboardText}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Signed-in account used for calendar sync" Foreground="{DynamicResource DashboardSubText}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Background="{DynamicResource SidebarHoverBackground}"
                    BorderBrush="{DynamicResource DashboardBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Account icon -->
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="17"
                            Background="#1A0078D4"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#xE8A1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#880078D4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- User info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountIdText"
                                   Text="Loading..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashboardText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Google account"
                                   FontSize="10"
                                   Foreground="{DynamicResource DashboardSubText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Sign Out button -->
                    <Button x:Name="SignOutButton"
                            Grid.Column="2"
                            Content="Sign out"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Padding="12,6"
                            Margin="10,0,0,0"
                            Background="#18FF4444"
                            Foreground="#FFFF6666"
                            BorderBrush="#25FF4444"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="SignOutButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
