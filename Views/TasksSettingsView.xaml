<UserControl x:Class="WpfWidgets.Views.TasksSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <Grid>
        <StackPanel>
            <!-- Title Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="&#xE8E9;" 
                           FontFamily="{StaticResource MaterialSymbolsOutlined}" 
                           Typography.StandardLigatures="True"
                           Typography.ContextualLigatures="True"
                           Foreground="#FF0078D4" 
                           FontSize="18" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"/>
                <TextBlock Text="Tasks Widget Settings" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource DashboardText}" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Separator Background="{DynamicResource DashboardBorder}" Margin="0,0,0,16"/>

            <StackPanel>
                <!-- Enable Widget Toggle Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Enable Tasks Widget" Foreground="{DynamicResource DashboardText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Show or hide the tasks list on your desktop wallpaper" Foreground="{DynamicResource DashboardSubText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="TasksEnabledToggle" 
                              Grid.Column="1" 
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="TasksEnabledToggle_Changed" 
                              Unchecked="TasksEnabledToggle_Changed"
                              VerticalAlignment="Center"/>
                </Grid>

                <Separator Background="{DynamicResource DashboardBorder}" Margin="0,16"/>

                <!-- Lock Position Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Lock Position" Foreground="{DynamicResource DashboardText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Prevent dragging and ignore mouse clicks" Foreground="{DynamicResource DashboardSubText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="LockPositionToggle" 
                              Grid.Column="1" 
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="LockPositionToggle_Changed" 
                              Unchecked="LockPositionToggle_Changed"
                              VerticalAlignment="Center"/>
                </Grid>

                <Separator Background="{DynamicResource DashboardBorder}" Margin="0,16"/>

                <!-- Task View Selection Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Task View" Foreground="{DynamicResource DashboardText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Select view to display on desktop widget" Foreground="{DynamicResource DashboardSubText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="ViewSelector" 
                              Grid.Column="1" 
                              Width="160"
                              Height="32"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="ViewSelector_SelectionChanged">
                    </ComboBox>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
